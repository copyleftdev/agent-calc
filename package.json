{
  "name": "oddly-exact-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build --target web --out-dir public/wasm --release --locked",
    "dev": "npm run wasm:build && next dev",
    "build": "next build",
    "build:local": "npm run wasm:build && next build",
    "build:worker": "npm run wasm:build && opennextjs-cloudflare build",
    "build:sites-archive": "scripts/build-sites-archive.sh",
    "preview": "npm run wasm:build && opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/web/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-tooltip": "1.2.16",
    "katex": "0.18.1",
    "motion": "12.42.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "@node-minify/core": {
      "glob": "11.1.0"
    }
  }
}
